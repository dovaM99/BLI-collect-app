{
  "expo": {
    "name": "BLI Collect",
    "slug": "bli-collect",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.bantulanguages.blicollect"
    },
    "android": {
      "package": "com.bantulanguagesinitiative.bli_collect",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./logo/logo-bli-futurist.png"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./logo/logo-bli-futurist.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 240
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8a148a0b-4486-4c67-8fee-e6e0c2fe5a1f"
      }
    },
    "owner": "bli-team"
  }
}
